# انسخ هذا الملف إلى .env واملأ القيم الحقيقية — لا ترفع .env إلى git أبداً

# قاعدة البيانات (docker-compose.yml يشغّل واحدة محلياً بهذه القيم افتراضياً)
DATABASE_URL="postgresql://masari:masari@localhost:5432/masari"

# الطابور (Redis) — نفس الشيء، docker-compose يشغّله محلياً
REDIS_URL="redis://localhost:6379"

# قفل الاعتماد — يطابق EXTERNAL_SEND_APPROVED في مشروع Apps Script
# ما دامت false: كل بريد "خارجي" (لعميل) يُعاد توجيهه إلى OWNER_EMAIL
# فقط، لتعاينه قبل تفعيل الإرسال الفعلي. لا تغيّرها إلى true إلا
# بعد اعتماد صريح ونهائي منك.
EXTERNAL_SEND_APPROVED=false
OWNER_EMAIL="hezmai425@gmail.com"

# خدمة البريد (SendGrid / Mailgun / Amazon SES / أي SMTP) — عبّئها
# عند الانتقال من "تجربة محلية" إلى إرسال فعلي
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="شركة مساري لريادة الأعمال"
SMTP_FROM_EMAIL=""

# Gemini AI — نفس المفتاح المستخدم حالياً في Apps Script (Google AI Studio)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# رابط عام يُستخدم في روابط تعبئة بيانات العميل المُرسَلة له
PUBLIC_BASE_URL="http://localhost:3000"

PORT="3000"
